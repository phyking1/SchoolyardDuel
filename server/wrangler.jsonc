{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolyardduel-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      { "name": "DUEL_ROOM", "class_name": "DuelRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DuelRoom"] }
  ]
}
